# Copy to .env, fill in the connection, and pass the file to docker run --env-file.
# For a local Java process, export these settings in its environment.
DATABASE_URL=jdbc:postgresql://postgres.example.com:5432/windlass
DATABASE_USERNAME=windlass
DATABASE_PASSWORD=

WINDLASS_MCP_ENABLED=true
# Daily cleanup at 03:00 UTC uses notification receipt age; positive integer.
NOTIFICATION_RETENTION_DAYS=30
