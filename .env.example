# Demo configuration. Copy this file to .env in the repository root:
#   cp .env.example .env
# Docker Compose reads .env automatically. No credentials are needed here.

# Browser ports: Windlass http://localhost:6080, n8n http://localhost:5678.
# The source-build Compose file binds both ports to localhost.
WINDLASS_PORT=6080
N8N_PORT=5678
WINDLASS_MCP_ENABLED=true

# Local folders bind-mounted into Windlass. Absolute paths also work.
# Prepare these folders before starting Compose and grant UID 10001
# read/write access. For new folders on Linux:
#   mkdir -p ref-docs json-conf
#   sudo chown 10001:10001 ref-docs json-conf
REF_DOCS_HOST_DIRECTORY=./ref-docs
JSON_CONF_HOST_DIRECTORY=./json-conf

# n8n defaults for local HTTP access.
N8N_VERSION=2.41.3
N8N_IMAGE_REPOSITORY=ghcr.io/n8n-io/n8n
N8N_TIMEZONE=Etc/UTC
N8N_SECURE_COOKIE=false
# Optional browser URLs; omit to derive them from N8N_PORT.
# N8N_EDITOR_BASE_URL=http://localhost:5678/
# N8N_WEBHOOK_URL=http://localhost:5678/

# Used only by compose.deploy.yaml (published image deployment).
WINDLASS_IMAGE=ghcr.io/rakorth/windlass:latest
BIND_ADDRESS=127.0.0.1

# Optional standalone Java settings (Compose uses fixed container paths).
# Maven/Java does not load .env automatically. Export these values first,
# for example: set -a; . ./.env; set +a
# SERVER_PORT=8080
# DATABASE_URL=jdbc:sqlite:./notifications.db
# REF_DOCS_DIRECTORY=./ref-docs
# JSON_CONF_DIRECTORY=./json-conf
