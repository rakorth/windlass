# Optional settings. Copy to .env beside compose.yaml in the extracted bundle.
# Defaults work without a .env file.
WINDLASS_IMAGE=ghcr.io/rakorth/windlass:latest
WINDLASS_PORT=6080
# Notification MCP tools are enabled at /mcp. Set false to disable them.
WINDLASS_MCP_ENABLED=true
N8N_PORT=5678
BIND_ADDRESS=127.0.0.1
N8N_TIMEZONE=Etc/UTC
N8N_VERSION=2.41.3
N8N_IMAGE_REPOSITORY=ghcr.io/n8n-io/n8n
N8N_SECURE_COOKIE=false

# Browser-facing URLs default to http://localhost:<N8N_PORT>/.
# Set these when using a different hostname or an HTTPS reverse proxy.
# N8N_EDITOR_BASE_URL=https://automations.example.com/
# N8N_WEBHOOK_URL=https://automations.example.com/
# Set N8N_SECURE_COOKIE=true for an HTTPS editor.

# Keep the same project name to reuse existing data volumes.
# COMPOSE_PROJECT_NAME=windlass-deployment

# Host folder for Markdown files; must be writable by container UID 10001.
# REF_DOCS_HOST_DIRECTORY=/absolute/path/to/ref-docs
